@page "/tickets/manage/{TicketId:int}"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TicketSystemAriMoraless.Data
@using TicketSystemAriMoraless.Enums
@using TicketSystemAriMoraless.Models
@using TicketSystemAriMoraless.Services

@attribute [Authorize]

@inject TicketService TicketService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<h3>Manage Ticket</h3>

@if (!string.IsNullOrEmpty(feedbackMessage))
{
    <div class="alert alert-success">
        @feedbackMessage
    </div>
}

@if (ticket == null)
{
    <p>Cargando...</p>
}
else
{
    <div class="card p-4 mb-5">

        <h4>@ticket.Title</h4>

        <p>@ticket.Description</p>

        <p>
            <b>Status:</b> @ticket.Status
        </p>

        <hr />

        <h5>Conversation History</h5>

        <div style="border:1px solid lightgray; padding:15px; height:300px; overflow-y:auto;">

            @if (!comments.Any())
            {
                <p>No messages yet.</p>
            }
            else
            {
                @foreach (var c in comments)
                {
                    <div class="mb-3">
                        <b>@c.User?.Email</b>
                        <br />
                        <small>@c.CreatedAt.ToLocalTime()</small>
                        <p>@c.Content</p>
                    </div>
                }
            }

        </div>

        <br />

        <input class="form-control"
               placeholder="Write a comment..."
               @bind="newCommentContent" />

        <br />

        <button class="btn btn-primary"
                @onclick="SendComment">
            Send
        </button>

        <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Technician}")">
            <Authorized>

                <hr />

                @if (ticket.Status != TicketStatus.Resolved)
                {
                    <h5>Asignar Técnico</h5>

                    <select class="form-select" @bind="selectedTechId">
                        <option value="">-- Selecciona técnico --</option>

                        @foreach (var tech in technicians)
                        {
                            <option value="@tech.Id">@tech.Email</option>
                        }
                    </select>

                    <br />

                    <button class="btn btn-success w-100"
                            @onclick="Assign">
                        Asignar
                    </button>

                    <hr />
                }

                <h5>Cambiar Estado</h5>

                @if (ticket.Status == TicketStatus.Open)
                {
                    <button class="btn btn-warning w-100 mb-2"
                            @onclick="() => UpdateStatus(TicketStatus.InProgress)">
                        Start Work
                    </button>
                }

                @if (ticket.Status == TicketStatus.InProgress)
                {
                    <button class="btn btn-success w-100 mb-2"
                            @onclick="() => UpdateStatus(TicketStatus.Resolved)">
                        Mark as Resolved
                    </button>
                }

                @if (ticket.Status == TicketStatus.Resolved)
                {
                    <div class="alert alert-info mt-3">
                        This ticket is closed. No more action buttons are available.
                    </div>
                }

            </Authorized>
        </AuthorizeView>

        <br />
        <br />
        <br />

    </div>
}

@code {
    [Parameter] public int TicketId { get; set; }

    private Ticket? ticket;
    private List<ApplicationUser> technicians = new();
    private List<TicketComment> comments = new();

    private string selectedTechId = "";
    private string newCommentContent = "";
    private string feedbackMessage = "";
    private string currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        currentUserId =
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        await LoadData();

        bool isAdminOrTech =
            user.IsInRole(Roles.Admin) ||
            user.IsInRole(Roles.Technician);

        if (!isAdminOrTech && ticket?.AuthorId != currentUserId)
        {
            Navigation.NavigateTo("/tickets/my-list");
        }
    }

    private async Task LoadData()
    {
        ticket = await TicketService.GetTicketByIdAsync(TicketId);
        technicians = await TicketService.GetTechniciansAsync();
        comments = await TicketService.GetCommentsAsync(TicketId);

        if (ticket?.TechnicianId != null)
        {
            selectedTechId = ticket.TechnicianId;
        }
    }

    async Task SendComment()
    {
        if (string.IsNullOrWhiteSpace(newCommentContent))
            return;

        var comment = new TicketComment
        {
            Content = newCommentContent,
            TicketId = TicketId,
            UserId = currentUserId,
            CreatedAt = DateTime.UtcNow
        };

        await TicketService.AddCommentAsync(comment);

        newCommentContent = "";
        feedbackMessage = "Comment posted successfully.";
        comments = await TicketService.GetCommentsAsync(TicketId);
    }

    async Task Assign()
    {
        if (!string.IsNullOrEmpty(selectedTechId))
        {
            await TicketService.UpdateTicketStatusAsync(
                TicketId,
                TicketStatus.Open,
                selectedTechId,
                currentUserId
            );

            feedbackMessage = "Technician assigned.";
            await LoadData();
        }
    }

    async Task UpdateStatus(TicketStatus status)
    {
        await TicketService.UpdateTicketStatusAsync(
            TicketId,
            status,
            null,
            currentUserId
        );

        feedbackMessage = $"Ticket marked as {status}.";
        await LoadData();
    }
}