@page "/tickets/my-list"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TicketSystemAriMoraless.Data
@using TicketSystemAriMoraless.Enums
@using TicketSystemAriMoraless.Models
@using TicketSystemAriMoraless.Services

@inject TicketService TicketService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

@attribute [Authorize]

<h3>My Ticket List</h3>

@if (userTickets == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-hover mt-3">
        <thead>
            <tr>
                <th>Title</th>
                <th>Role</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var ticket in userTickets)
            {
                <tr>
                    <td>@ticket.Title</td>

                    <td>
                        @if (ticket.AuthorId == currentUserId && ticket.TechnicianId == currentUserId)
                        {
                            <span class="badge bg-dark">Author & Technician</span>
                        }
                        else if (ticket.AuthorId == currentUserId)
                        {
                            <span class="badge bg-secondary">Author</span>
                        }
                        else if (ticket.TechnicianId == currentUserId)
                        {
                            <span class="badge bg-info text-dark">Assigned</span>
                        }
                    </td>

                    <td>
                        <span class="badge @GetStatusClass(ticket.Status)">
                            @ticket.Status
                        </span>
                    </td>

                    <td>@ticket.Priority</td>

                    <td>
                        <button class="btn btn-sm btn-success"
                                @onclick="() => GoToManage(ticket.Id)">
                            Work on it
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Ticket>? userTickets = new();

    private string currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();

        currentUserId =
            authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        if (!string.IsNullOrEmpty(currentUserId))
        {
            userTickets =
                await TicketService.GetMyWorkAndRequestsAsync(currentUserId);
        }
    }

    private string GetStatusClass(TicketStatus status) => status switch
    {
        TicketStatus.Open => "bg-info text-dark",
        TicketStatus.InProgress => "bg-warning text-dark",
        TicketStatus.Resolved => "bg-success",
        _ => "bg-secondary"
    };

    void GoToManage(int id)
    {
        Navigation.NavigateTo("/tickets/manage/" + id);
    }
}