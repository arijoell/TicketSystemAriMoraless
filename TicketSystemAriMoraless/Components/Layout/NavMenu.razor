@using Microsoft.AspNetCore.Components.Authorization
@using TicketSystemAriMoraless.Data
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Ticket System</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill"></span> Home
            </NavLink>
        </div>

        <!-- 🔥 FIX PRINCIPAL AQUÍ -->
        <AuthorizeView Context="authContext">
            <Authorized>

                <!-- CREAR TICKET -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tickets/create">
                        <span class="bi bi-plus-square-fill"></span> New Ticket
                    </NavLink>
                </div>

                <!-- MIS TICKETS -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tickets/my-list">
                        <span class="bi bi-list-ul"></span> My Tickets
                    </NavLink>
                </div>

                <!-- 🔥 ADMIN -->
                <AuthorizeView Roles="@Roles.Admin" Context="adminContext">

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/dashboard">
                            <span class="bi bi-speedometer2"></span> Dashboard
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/users">
                            <span class="bi bi-people"></span> User Management
                        </NavLink>
                    </div>

                </AuthorizeView>

                <!-- LOGOUT -->
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link btn btn-link">
                            <span class="bi bi-arrow-bar-left"></span> Logout
                        </button>
                    </form>
                </div>

                <!-- 🔥 AQUÍ TAMBIÉN CAMBIA context -->
                <div class="nav-item px-3">
                    <span class="nav-link">@authContext.User.Identity?.Name</span>
                </div>

            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-badge"></span> Register
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private string currentUrl = string.Empty;

    protected override void OnInitialized()
    {
        currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
    }
}